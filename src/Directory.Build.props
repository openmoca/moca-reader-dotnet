<!--
  NuGet metadata shared by every package in src/. Each project sets its own PackageId and Description.
-->
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Version>0.7.0</Version>
    <Authors>MOCA Standard Contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/openmoca/moca-reader-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openmoca/moca-reader-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The logo, one copy at the repository root, in every package (the same file as moca-mcp-dotnet's). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
